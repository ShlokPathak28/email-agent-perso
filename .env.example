# ─── Provider ─────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=gmail          # "gmail" or "outlook"

# ─── Gmail ────────────────────────────────────────────────────────────────────
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ─── Outlook / Microsoft Graph ────────────────────────────────────────────────
OUTLOOK_CLIENT_ID=your-client-id
OUTLOOK_CLIENT_SECRET=your-client-secret
OUTLOOK_TENANT_ID=common

# ─── Processing ───────────────────────────────────────────────────────────────
TIME_WINDOW_HOURS=24
PROCESS_UNREAD_ONLY=true
MAX_RESULTS=100

# ─── Priority Contacts (comma-separated emails/domains) ───────────────────────
HIGH_PRIORITY_CONTACTS=boss@company.com,ceo@company.com,hr@company.com

# ─── Scheduling ───────────────────────────────────────────────────────────────
SCHEDULE_INTERVAL_MINUTES=15

# ─── Summarizer (optional: openai, local, none) ───────────────────────────────
SUMMARIZER_MODEL=none
OPENAI_API_KEY=

# ─── Telegram Notifications ────────────────────────────────────────────────────
# Get bot token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
